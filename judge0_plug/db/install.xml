<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/judge0/db" VERSION="20260322" COMMENT="XMLDB file for Moodle question/type/judge0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="qtype_judge0_options" COMMENT="Options for judge0 questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to question table"/>
        <FIELD NAME="language_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="71" SEQUENCE="false" COMMENT="Judge0 language ID"/>
        <FIELD NAME="checker_code" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher test code"/>
        <FIELD NAME="allowed_languages" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of allowed language IDs"/>
        <FIELD NAME="compiler_options" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Additional compiler options"/>
        <FIELD NAME="cpu_time_limit" TYPE="number" LENGTH="10" DECIMALS="3" NOTNULL="false" SEQUENCE="false" COMMENT="CPU time limit in seconds"/>
        <FIELD NAME="memory_limit" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Memory limit in KB"/>
        <FIELD NAME="reference_solution_language_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Language ID for reference solution"/>
        <FIELD NAME="expected_output" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Expected exact output from Judge0"/>
        <FIELD NAME="reference_solution" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher reference solution"/>
        <FIELD NAME="input_generator_code" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Script to generate dynamic input per student"/>
        <FIELD NAME="input_generator_language_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Language ID for input generator"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="qtype_judge0_testcases" COMMENT="Test cases for judge0 questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to question table"/>
        <FIELD NAME="test_input" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Standard input for the test case"/>
        <FIELD NAME="expected_output" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Expected standard output, can be null if dynamically computed"/>
        <FIELD NAME="is_hidden" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if the test case is hidden from the student"/>
        <FIELD NAME="weight" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1.0" SEQUENCE="false" DECIMALS="5" COMMENT="Weight or score of this test case"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="qtype_judge0_queue" COMMENT="Queued Judge0 recheck jobs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Public polling token"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Owner user id"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Quiz attempt id"/>
        <FIELD NAME="usageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question usage id"/>
        <FIELD NAME="slot" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question slot in the attempt"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Question id"/>
        <FIELD NAME="languageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Judge0 language id"/>
        <FIELD NAME="answerhash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Hash of answer and language"/>
        <FIELD NAME="answer" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Submitted answer snapshot"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued" SEQUENCE="false" COMMENT="queued, running, completed, failed"/>
        <FIELD NAME="fraction" TYPE="number" LENGTH="10" DECIMALS="7" NOTNULL="false" SEQUENCE="false" COMMENT="Grade fraction"/>
        <FIELD NAME="state" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle question state"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Judge0 result JSON"/>
        <FIELD NAME="error" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Last processing error"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token" UNIQUE="true" FIELDS="token"/>
        <INDEX NAME="ownerhash" UNIQUE="false" FIELDS="userid, attemptid, slot, questionid, answerhash"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
